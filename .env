# Site settings. Nothing here is secret: every value ends up public on the website itself.
# Local overrides that should stay private go in .env.local (ignored by git).

# Public site address, with no slash at the end. Canonical tags, Open Graph URLs, structured data,
# robots.txt and sitemap.xml all use it. Vercel builds and publishes the site on every push to main.
# When a custom domain is connected in Vercel, change this one line to it (for example
# https://www.mrsakbardriving.ca) and push. (A folder in the address, like /site, also works: every
# link gets that prefix at build time.)
VITE_SITE_URL=https://mrsakbardriving.vercel.app

# Number of Google reviews on her Hamilton profile (58 as of 2026-10-06, every one five stars).
# Update this as reviews come in; every mention on the page and in llms.txt follows it.
# The reviews section says every review is five stars: if one below five ever comes in,
# change that sentence in index.html (search for "is five stars").
VITE_GOOGLE_REVIEWS=58

# Google Search Console: choose the "HTML tag" method and paste only the content="..." value here,
# then rebuild and deploy, and press Verify. (Or upload Google's googleXXXX.html file into public/.)
VITE_GSC_VERIFICATION=

# Bing Webmaster Tools: "Meta tag" method, paste only the content value. (Bing can also import from Search Console.)
VITE_BING_VERIFICATION=

# IndexNow key (free; tells Bing and other IndexNow search engines about new or changed pages).
# The matching key file is public/1b0ce34045babc017ab32dd1853aa0c8.txt. After deploying, run: npm run indexnow
VITE_INDEXNOW_KEY=1b0ce34045babc017ab32dd1853aa0c8
