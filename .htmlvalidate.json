{
  "extends": [
    "html-validate:recommended"
  ],
  "rules": {
    "no-inline-style": "off",
    "long-title": "off",
    "attribute-boolean-style": "off",
    "void-style": "off",
    "no-trailing-whitespace": "off",
    "attr-quotes": "off",
    "doctype-style": "off",
    "tel-non-breaking": "off",
    "aria-label-misuse": [
      "error",
      {
        "allowAnyNamable": true
      }
    ]
  }
}